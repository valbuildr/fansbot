{
  "name": "fansbot",
  "private": true,
  "scripts": {
    "turbo:build": "turbo run build",
    "turbo:dev": "turbo run dev",
    "turbo:lint": "turbo run lint",
    "turbo:format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "turbo:check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@turbo/gen": "^2.9.12",
    "@types/bun": "^1.3.13",
    "prettier": "^3.7.4",
    "turbo": "^2.9.12",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.8",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
