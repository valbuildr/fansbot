{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "DISCORD_TOKEN",
    "DISCORD_CLIENT_ID",
    "DISCORD_CLIENT_SECRET",
    "DATABASE_URL",
    "REDIS_SECRET",
    "BETTER_AUTH_SECRET"
  ],
  "tasks": {
    "turbo:build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "turbo:lint": {
      "dependsOn": ["^lint"]
    },
    "turbo:check-types": {
      "dependsOn": ["^check-types"]
    },
    "turbo:dev": {
      "cache": false,
      "persistent": true
    },
    "dev": {}
  }
}
